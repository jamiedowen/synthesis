<?xml version="1.0" encoding="UTF-8"?>

<!-- Android build of CJ Autoworx RevHead (the standalone app; Android has no VST hosts).
     JUCE's CMake API can't target Android, so this Projucer project generates an
     Android Studio / Gradle project. Run build-android.sh rather than editing by hand. -->
<JUCERPROJECT id="CjAwRh" name="CJAutoworxRevHead" projectType="audioplug" version="1.0.0"
              companyName="CJ Autoworx" bundleIdentifier="com.cjautoworx.revhead"
              pluginFormats="buildStandalone" pluginCharacteristicsValue="pluginIsSynth,pluginWantsMidiIn"
              pluginName="CJ Autoworx RevHead" pluginDesc="Engine synthesizer" pluginManufacturer="CJ Autoworx"
              pluginManufacturerCode="CJAw" pluginCode="RvHd" binaryDataNamespace="CJBinary"
              cppLanguageStandard="20" displaySplashScreen="0" jucerFormatVersion="1"
              defines="JUCE_WEB_BROWSER=0&#10;JUCE_USE_CURL=0&#10;JUCE_DISPLAY_SPLASH_SCREEN=0">
  <MAINGROUP id="CjMain" name="CJAutoworxRevHead">
    <GROUP id="CjSrcG" name="Source">
      <FILE id="CjEngH" name="Engine.h" compile="0" resource="0" file="../Source/Engine.h"/>
      <FILE id="CjPreH" name="Presets.h" compile="0" resource="0" file="../Source/Presets.h"/>
      <FILE id="CjProH" name="PluginProcessor.h" compile="0" resource="0" file="../Source/PluginProcessor.h"/>
      <FILE id="CjProC" name="PluginProcessor.cpp" compile="1" resource="0" file="../Source/PluginProcessor.cpp"/>
      <FILE id="CjEdiH" name="PluginEditor.h" compile="0" resource="0" file="../Source/PluginEditor.h"/>
      <FILE id="CjEdiC" name="PluginEditor.cpp" compile="1" resource="0" file="../Source/PluginEditor.cpp"/>
    </GROUP>
    <GROUP id="CjResG" name="Resources">
      <FILE id="CjFace" name="jarrad.png" compile="0" resource="1" file="../Resources/jarrad.png"/>
    </GROUP>
  </MAINGROUP>
  <MODULES>
    <MODULE id="juce_audio_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_devices" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_formats" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_plugin_client" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_processors" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_utils" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_core" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_data_structures" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_events" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_graphics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_extra" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
  </MODULES>
  <EXPORTFORMATS>
    <ANDROIDSTUDIO targetFolder="Builds/Android" androidMinimumSDK="24" androidScreenOrientation="landscape"
                   bigIcon="CjFace" smallIcon="CjFace" microphonePermissionNeeded="0">
      <CONFIGURATIONS>
        <CONFIGURATION isDebug="1" name="Debug"/>
        <CONFIGURATION isDebug="0" name="Release"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_plugin_client" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_utils" path="JUCE/modules"/>
        <MODULEPATH id="juce_core" path="JUCE/modules"/>
        <MODULEPATH id="juce_data_structures" path="JUCE/modules"/>
        <MODULEPATH id="juce_events" path="JUCE/modules"/>
        <MODULEPATH id="juce_graphics" path="JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics" path="JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra" path="JUCE/modules"/>
      </MODULEPATHS>
    </ANDROIDSTUDIO>
  </EXPORTFORMATS>
  <JUCEOPTIONS JUCE_STRICT_REFCOUNTEDPOINTER="1" JUCE_VST3_CAN_REPLACE_VST2="0"/>
</JUCERPROJECT>
